{
	"schemaVersion": 1,
	"id": "dynamichud",
	"version": "${version}",
	"name": "Dynamic HUD",
	"description": "Makes HUD dynamic, hides elements when not needed.",
	"authors": [
		"maDU59_"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/dynamichud/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.madu59.dynamichud.DynamicHudMod"
		],
		"client": [
			"fr.madu59.dynamichud.DynamicHudClient"
		],
		"modmenu": [
			"fr.madu59.dynamichud.config.configscreen.ModMenuIntegration"
		]
	},
	"mixins": [
		"dynamichud.mixins.json",
		{
			"config": "dynamichud.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"accessWidener":"dynamichud.classtweaker",
	"suggests": {
		"another-mod": "*"
	}
}